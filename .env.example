# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI configuration
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter (https://openrouter.ai/keys) — used by /api/import to detect
# recurring subscriptions from an uploaded bank statement (CSV or PDF),
# routed through openai/gpt-4o-mini
OPENROUTER_API_KEY=your-openrouter-api-key

# Vercel Blob (Vercel dashboard -> Storage -> Blob -> Create Store -> token) —
# temporary storage for bank statements uploaded to /api/import/upload. Files
# are deleted again as soon as /api/import finishes analyzing them.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-rw-token

# Service role key (Settings -> API in Supabase). Server-only, used by the
# /api/cron/send-reminders route to read across all users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (https://resend.com) — used to send renewal-reminder e-mails
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Killsub <onboarding@resend.dev>

# Shared secret that must match the value configured for the Vercel Cron Job
# (Vercel Project Settings -> Cron Jobs), sent as "Authorization: Bearer <value>"
CRON_SECRET=your-cron-secret

# Public site URL, used to build links inside e-mails
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Stripe (https://dashboard.stripe.com/apikeys) — Pro plan billing
STRIPE_SECRET_KEY=sk_live_or_test_...
# From the webhook endpoint you create at dashboard.stripe.com/webhooks
# pointing to https://<your-app>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Products (Pro plan, monthly/yearly recurring prices)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Not required by the current redirect-based Checkout flow (no Stripe.js on the client),
# but documented for future use (e.g. embedded Elements).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...

# Resend inbound email (forward-a-receipt import). Configure inbound routing for
# *@<KILLSUB_IMPORT_DOMAIN> in the Resend dashboard, pointing to
# https://<your-app>/api/email/inbound
RESEND_INBOUND_SECRET=whsec_...
KILLSUB_IMPORT_DOMAIN=killsub.app

# Web Push (VAPID) — renewal reminder push notifications, sent by the same
# /api/cron/send-reminders job. Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is safe for the browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Sentry (https://sentry.io) — error monitoring for client, server, and edge.
# DSNs aren't secret, so one NEXT_PUBLIC_ value is reused everywhere.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional — only needed to upload source maps during build (nicer stack
# traces in Sentry). Leave unset and builds skip source map upload entirely.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
